# Copy these names into Vercel: Project > Settings > Environment Variables.
# Never commit real values.

# Gemini (Google AI Studio API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
AI_ENABLED=true
TTS_ENABLED=true

# Supabase: Project Settings > API keys. Use the secret key (sb_secret_...).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Passcode for /panel
PANEL_PASSCODE=
